#!/usr/bin/env bash
# ARC worktrees for a repo, each in its own herdr Space running an agent.
# Run from herdr-plus quick actions (herdr-plus.nix); see `usage` below.
#
# Checkouts live under ~/source/worktrees/<repo>/<branch>, herdr's configured
# worktrees.directory (herdr.nix): devops' .envrc runs `source_up`, and the API
# keys, GitHub token, and sticky AWS profile come from ~/source/.envrc, which
# only a checkout under ~/source inherits. direnv whitelists that root.
#
# Deliberately not a herdr-plus worktree layout: those fire on every
# `herdr worktree create`, including the ones herdr-projects makes for its
# threads, and would stack extra tabs onto those Spaces.
#
# Every run also logs to the journal: `journalctl -t herdr-arc -e`.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: herdr-arc new     REPO REQUEST...     in the background: file an ARC ticket via
                                             Claude Code, branch it, start the agent on it
       herdr-arc tickets REPO                my open ARC tickets, for a select picker
       herdr-arc key     REPO KEY [TOPIC...] branch an existing ticket (1234 short topic)
       herdr-arc list    REPO [worktrees]    ARC branches (or only checkouts), for a picker
       herdr-arc current REPO                the ARC branch of the focused Space, if any
       herdr-arc open    REPO BRANCH         focus, reopen, or check out an existing branch
       herdr-arc close   REPO BRANCH         remove the checkout, then mark the ticket Done
       herdr-arc finish  REPO KEY_OR_BRANCH  retry only the Jira transition, without a checkout
EOF
  exit 2
}

# Agent started in a new Space; override with HERDR_ARC_AGENT.
agent="${HERDR_ARC_AGENT:-claude}"
site=alchemer.atlassian.net
worktree_root="$HOME/source/worktrees"
# Set in the detached copy `new` re-runs itself as; see cmd_new.
detached="${HERDR_ARC_DETACHED:-}"
# A Space opened from the background must not steal focus mid-keystroke.
focus=--focus
[ -z "$detached" ] || focus=--no-focus

# Git-ignored files a fresh checkout lacks but the main one carries: local
# direnv overrides and Claude Code's per-project permission grants.
local_files=(.envrc.local .claude/settings.local.json)
# Git-ignored directories any tool rebuilds on demand; `close` removes them
# without asking. Matched by name at any depth.
regenerable_dirs='^(.*/)?(\.terraform|\.direnv|\.venv|node_modules|__pycache__|\.pytest_cache|\.mypy_cache|\.ruff_cache)/'

# The quick-action pane closes when this exits; on failure, hold it open so the
# error is readable instead of flashing by. `list` feeds a picker, never a pane.
hold_on_failure() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    printf '\nFailed (exit %s) · Enter closes\n' "$status" >&2
    read -r _ </dev/tty || true
  fi
}

# The detached `new` has no pane to hold open, so it reports through herdr.
notify_on_failure() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    echo "Failed (exit $status)" >&2
    notify "ARC: new ticket failed" "journalctl -t herdr-arc -e"
  fi
}

notify() {
  herdr notification show "$1" --body "$2" --sound request >/dev/null || true
}

# Mirror a pane-facing run into the journal so its output outlives the pane.
# Pickers (list, tickets) mirror only stderr: their stdout is the option list.
log_to_journal() {
  local picker=$1
  shift
  systemd-cat -t herdr-arc echo "herdr-arc $command $repo $*" || true
  if [ -z "$picker" ]; then
    exec > >(tee >(systemd-cat -t herdr-arc))
  fi
  exec 2> >(tee >(systemd-cat -t herdr-arc -p err) >&2)
}

# Lowercase hyphenated words, at most 40 characters, no dangling hyphen.
slugify() {
  local slug
  slug="$(tr '[:upper:]' '[:lower:]' <<<"$*" | tr -cs 'a-z0-9' '-')"
  slug="${slug#-}"
  slug="${slug:0:40}"
  printf '%s' "${slug%-}"
}

has_ref() {
  git -C "$repo" show-ref --quiet "$1"
}

# Run one Jira task without built-in shell/file tools. TOOLS names the MCP
# calls pre-approved for this task (comma-separated, without mcp__atlassian__).
# Other Atlassian tools remain advertised but are not pre-approved.
# Only the Atlassian server, under a name of its own: a claude.ai Atlassian
# connector would otherwise shadow the Home Manager one, and nothing else
# needs to start. Unset ANTHROPIC_API_KEY so the claude.ai login is used.
# An empty cwd keeps repo context out of a few-tool-call session. The session
# id is logged so its transcript can be found when a reply looks wrong.
claude_jira() {
  local tools=$1 prompt=$2 mcp scratch session output status=0
  mcp="$(jq -cn --arg url "${ATLASSIAN_MCP_URL:?}" '{mcpServers: {atlassian: {type: "http", url: $url}}}')"
  scratch="$(mktemp -d)"
  session="$(</proc/sys/kernel/random/uuid)"
  echo "Claude Code session $session (~/.claude/projects/*/$session.jsonl)" >&2
  output="$(cd "$scratch" && env -u ANTHROPIC_API_KEY claude -p --model haiku \
    --session-id "$session" --tools "" --strict-mcp-config --mcp-config "$mcp" \
    --allowedTools="mcp__atlassian__${tools//,/,mcp__atlassian__}" \
    "On Jira cloudId $site: $prompt" </dev/null)" || status=$?
  rmdir "$scratch"
  printf '%s\n' "$output"
  return "$status"
}

# Fetch in the background so it overlaps the ticket call or the picker.
# Several runs may fetch at once (`new` is filed back to back) and Git fails
# all but one when they race to update refs/remotes/origin/main, so runs take
# turns on a lock in the shared Git directory. One retry covers a fetch started
# by something else, which leaves the ref current for the second attempt.
fetch_main() {
  local lock
  lock="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/herdr-arc-fetch.lock"
  (
    flock 9
    git -C "$repo" fetch --quiet origin main ||
      { sleep 1 && git -C "$repo" fetch --quiet origin main; }
  ) 9>"$lock" &
  fetch_pid=$!
}

# One JSON object per live worktree herdr knows for the repo.
worktrees() {
  herdr worktree list --cwd "$repo" |
    jq -c '.result.worktrees[] | select(.is_prunable | not)'
}

# The Space with focus; a popup overlays it without taking focus.
focused_space() {
  herdr workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id'
}

# Make a checkout behave like the main one: copy ignored local files, populate
# submodules from the main checkout's objects instead of re-cloning, and trust
# its mise.toml. Idempotent, so reopened checkouts heal too.
prepare() {
  local path=$1 file
  [ "$path" = "$repo" ] && return
  for file in "${local_files[@]}"; do
    if [ -f "$repo/$file" ] && [ ! -e "$path/$file" ]; then
      mkdir -p "$(dirname "$path/$file")"
      cp "$repo/$file" "$path/$file"
    fi
  done
  local sub reference
  while read -r _ sub; do
    reference="$(git -C "$repo/$sub" rev-parse --absolute-git-dir 2>/dev/null)" || reference=""
    if [ -n "$reference" ] && git -C "$path" submodule status -- "$sub" | grep -q '^-'; then
      echo "Populating submodule $sub"
      git -C "$path" submodule update --init --reference "$reference" -- "$sub" ||
        echo "submodule $sub failed; run 'git submodule update --init $sub' there" >&2
    fi
  done < <(git -C "$path" config -f .gitmodules --get-regexp '\.path$' 2>/dev/null || true)
  if [ -f "$path/mise.toml" ]; then
    mise trust --quiet "$path/mise.toml" || echo "mise trust failed for $path" >&2
  fi
}

# Open PATH as a Space labelled BRANCH; an already-open Space just gets focus,
# a new one gets an agent, handed PROMPT as its first message when given.
open_space() {
  local path=$1 branch=$2 prompt=${3:-} result pane name suffix
  result="$(herdr worktree open --cwd "$repo" --path "$path" --label "$branch" "$focus")"
  if jq -e '.result.already_open' <<<"$result" >/dev/null; then
    return
  fi
  pane="$(jq -er '.result.root_pane.pane_id | strings | select(length > 0)' <<<"$result")"
  # Herdr names allow only lowercase letters, digits, '-' and '_' (32 max).
  # Keep the ticket prefix readable and reserve a suffix for pane uniqueness.
  name="${branch,,}"
  name="${name//[^a-z0-9_-]/-}"
  suffix="$(printf '%s' "$pane" | sha256sum | cut -c1-12)"
  name="${name:0:19}-$suffix"
  herdr agent start "$name" --kind "$agent" --pane "$pane"
  if [ -n "$prompt" ]; then
    herdr agent prompt "$name" "$prompt"
  fi
}

# New branch from a freshly fetched origin/main, prepared and opened.
create_from_main() {
  local branch=$1 prompt=${2:-} path
  path="$worktree_root/$(basename "$repo")/$branch"
  if ! wait "$fetch_pid"; then
    echo "Fetch failed; no worktree created. Retry after restoring access to origin." >&2
    return 1
  fi
  git -C "$repo" worktree add --quiet --no-track -b "$branch" "$path" origin/main
  prepare "$path"
  open_space "$path" "$branch" "$prompt"
}

# REQUEST is free text: Claude Code turns it into a clean ticket summary and a
# short branch topic, and the agent in the new Space starts on the request
# itself. The quick-action popup only launches a detached copy of this, which
# logs to the journal and reports through herdr notifications.
cmd_new() {
  local request="$*"
  [ -n "$request" ] || usage
  if [ -z "$detached" ]; then
    HERDR_ARC_DETACHED=1 setsid -f systemd-cat -t herdr-arc --stderr-priority=err \
      "$0" new "$repo" "$request" </dev/null
    echo "Filing in the background; herdr notifies when the Space is ready."
    return
  fi
  notify "ARC: filing ticket" "$request"
  fetch_main
  echo "Filing an ARC ticket with Claude Code: $request"
  local output key summary topic branch
  output="$(claude_jira atlassianUserInfo,createJiraIssue "Create one Jira issue in project ARC from the request between the ---- lines:
----
$request
----
Summary: the request as a concise ticket title, spelling and grammar fixed, sentence case, at most 80 characters; keep names of repos, hosts, services and people as written. If the summary leaves out detail from the request, use the request verbatim as the description; otherwise no description. Issue type Task, assigned to the current user (look up their account id with atlassianUserInfo). Do nothing else.
Reply with only these three final lines:
KEY=<issue key>
SUMMARY=<summary used>
TOPIC=<2 to 5 lowercase words joined by hyphens naming the work, at most 40 characters, for a git branch>")"
  key="$(grep -oE '^KEY=ARC-[0-9]+' <<<"$output" | tail -n1 | cut -d= -f2)" || true
  if [ -z "$key" ]; then
    printf 'Claude Code did not return an ARC key:\n%s\n' "$output" >&2
    exit 1
  fi
  summary="$(sed -n 's/^SUMMARY=//p' <<<"$output" | tail -n1)"
  summary="${summary:-$request}"
  topic="$(sed -n 's/^TOPIC=//p' <<<"$output" | tail -n1)"
  branch="$key-$(slugify "${topic:-$summary}")"
  echo "Filed $key ($summary) · https://$site/browse/$key"
  if ! create_from_main "$branch" "Jira $key: $summary (https://$site/browse/$key). This worktree's branch $branch was cut from origin/main for it. The request as written: $request -- Start on it."; then
    printf '%s is filed but has no worktree. Create it with: herdr-arc key %q %q\n' \
      "$key" "$repo" "$key ${branch#"$key"-}" >&2
    notify "ARC: $key filed, worktree failed" "herdr-arc key $repo $key ${branch#"$key"-}"
    exit 1
  fi
  notify "ARC: $key ready" "Space $branch · $summary"
}

# My unresolved ARC tickets as "ARC-N summary<TAB>status", newest first. The
# whole label is the value, so `key` gets the summary for the branch topic.
# Claude Code takes a while, so answers are reused for a few minutes.
cmd_tickets() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-arc/tickets.tsv" output
  if [ -s "$cache" ] && [ -n "$(find "$cache" -mmin -5)" ]; then
    cat "$cache"
    return
  fi
  # A failed lookup still has to print one option, or the picker opens empty.
  output="$(claude_jira searchJiraIssuesUsingJql \
    "Search with JQL exactly 'project = ARC AND assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC', fields summary and status, up to 100 results. Do nothing else. Reply with one line per issue, exactly ISSUE|<key>|<status name>|<summary>, and nothing else.")" || output=""
  output="$(grep -E '^ISSUE\|ARC-[0-9]+\|' <<<"$output" |
    awk -F'|' '{ s = $4; for (i = 5; i <= NF; i++) s = s "|" $i; printf "%s %s\t%s\n", $2, s, $3 }')" || true
  if [ -z "$output" ]; then
    printf 'No open ARC tickets found (or Claude Code failed)\tsee journalctl -t herdr-arc, or run: herdr-arc key REPO ARC-N\n'
    return
  fi
  mkdir -p "$(dirname "$cache")"
  printf '%s\n' "$output" | tee "$cache"
}

cmd_key() {
  # "ARC-1234 Some summary", "1234 short topic", or "arc-1234": the first word
  # is the key (a bare number becomes ARC-N), the rest is slugged as the topic.
  local words key topic branch
  read -r -a words <<<"$*"
  [ "${#words[@]}" -gt 0 ] || usage
  key="${words[0]^^}"
  [[ $key =~ ^[0-9]+$ ]] && key="ARC-$key"
  if ! [[ $key =~ ^ARC-[0-9]+$ ]]; then
    echo "Got '${words[0]}'; start with a real ARC key, e.g. ARC-1234 short topic." >&2
    exit 2
  fi
  # Any branch already carrying the key opens instead of growing a sibling.
  branch="$(cmd_list | cut -f1 | grep -iE "^$key(-|$)" | head -n1)" || true
  if [ -n "$branch" ]; then
    echo "Opening existing $branch"
    cmd_open "$branch"
    return
  fi
  topic="$(slugify "${words[@]:1}")"
  branch="$key${topic:+-$topic}"
  fetch_main
  create_from_main "$branch"
}

# Branch<TAB>where it is: the focused Space, other open Spaces, then worktrees,
# then local branches and branches only on origin, newest first.
# Match both ARC-N and arc-N ticket branch prefixes.
cmd_list() {
  local only=${1:-} seen="" branch state ref
  while IFS=$'\t' read -r branch state; do
    printf '%s\t%s\n' "$branch" "$state"
    seen+="|$branch|"
  done < <(worktrees | jq -r --arg space "$(focused_space)" '
    select(.branch // "" | test("^arc-"; "i"))
    | if .open_workspace_id == $space then [0, .branch, "this Space"]
      elif .open_workspace_id then [1, .branch, "open Space"]
      else [2, .branch, "worktree"] end
    | @tsv' |
    sort -t$'\t' -k1,1n | cut -f2-)
  [ "$only" = worktrees ] && return
  for ref in refs/heads refs/remotes/origin; do
    while read -r branch; do
      [[ $seen == *"|$branch|"* ]] && continue
      seen+="|$branch|"
      if [ "$ref" = refs/heads ]; then state=branch; else state="origin only"; fi
      printf '%s\t%s\n' "$branch" "$state"
    done < <(git -C "$repo" for-each-ref --sort=-committerdate --format='%(refname:lstrip=-1)' \
      "$ref/[Aa][Rr][Cc]-*")
  done
}

cmd_current() {
  cmd_list worktrees | awk -F'\t' '$2 == "this Space" { print $1 }'
}

cmd_open() {
  local branch=${1:?usage: herdr-arc open REPO BRANCH} path
  path="$(worktrees | jq -r --arg b "$branch" 'select(.branch == $b) | .path' | head -n1)"
  if [ -z "$path" ]; then
    path="$worktree_root/$(basename "$repo")/$branch"
    # Remove stale Git worktree metadata for directories that no longer exist.
    git -C "$repo" worktree prune
    if has_ref "refs/heads/$branch"; then
      git -C "$repo" worktree add --quiet "$path" "$branch"
    else
      git -C "$repo" fetch --quiet origin "$branch"
      git -C "$repo" worktree add --quiet --track -b "$branch" "$path" "origin/$branch"
    fi
  fi
  prepare "$path"
  open_space "$path" "$branch"
}

# Complete the Jira step independently of checkout existence. A failed close
# can be recovered without recreating a worktree or repeating local cleanup.
finish_ticket() {
  local key=$1 output
  echo "Marking $key Done with Claude Code"
  output="$(claude_jira getJiraIssue,getTransitionsForJiraIssue,transitionJiraIssue \
    "Read issue $key with getJiraIssue. If its status is already Done, do nothing. Otherwise transition it to Done (find the transition with getTransitionsForJiraIssue; pick the one leading to Done), then read the issue again to confirm. Do nothing else. Reply with exactly DONE only when its status is confirmed Done; otherwise explain the failure.")" || return
  if ! grep -qx 'DONE' <<<"$output"; then
    printf 'Jira completion was not confirmed:\n%s\n' "$output" >&2
    return 1
  fi
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/herdr-arc/tickets.tsv"
}

cmd_finish() {
  local branch=${1:?usage: herdr-arc finish REPO KEY_OR_BRANCH} key answer
  if ! [[ ${branch^^} =~ ^(ARC-[0-9]+)(-|$) ]]; then
    echo "Expected an ARC ticket key or ticket-prefixed branch." >&2
    return 2
  fi
  key=${BASH_REMATCH[1]}
  printf 'Mark %s Done without changing any checkout? [y/N] ' "$key"
  read -r answer </dev/tty
  [[ $answer =~ ^[Yy]$ ]] || return 0
  finish_ticket "$key"
}

indent() {
  sed 's/^/  /'
}

# Git-ignored paths in checkout PATH that removing it would destroy for good:
# everything ignored except regenerable directories and the local files
# `prepare` copied in unchanged from the main checkout.
ignored_keepsakes() {
  local path=$1 entry file
  while IFS= read -r -d '' entry; do
    [[ $entry =~ $regenerable_dirs ]] && continue
    for file in "${local_files[@]}"; do
      if [ "$entry" = "$file" ] && cmp -s "$path/$entry" "$repo/$file"; then
        continue 2
      fi
    done
    printf '%s\n' "$entry"
  done < <(git -C "$path" ls-files -z --others --ignored --exclude-standard --directory)
}

# Close BRANCH's Space, remove its checkout, drop the branch if merged, and
# transition its ticket to Done. Tracked or untracked changes refuse the close.
# Work Git does not report as a change needs its own confirmation: ignored
# files and the task handoff are deleted with the checkout, and commits on no
# remote survive only on the kept local branch, so the ticket stays open unless
# confirmed.
cmd_close() {
  local branch=${1:?usage: herdr-arc close REPO BRANCH} entry path space key answer
  local keepsakes handoff unpushed
  entry="$(worktrees | jq -c --arg b "$branch" 'select(.branch == $b)' | head -n1)"
  path="$(jq -r '.path // empty' <<<"$entry")"
  space="$(jq -r '.open_workspace_id // empty' <<<"$entry")"
  if [ -z "$path" ] || [ "$path" = "$repo" ]; then
    echo "$branch has no linked checkout to remove." >&2
    exit 1
  fi
  if [ -n "$(git -C "$path" status --porcelain)" ]; then
    echo "$path has uncommitted changes; commit or discard them first." >&2
    git -C "$path" status --short >&2
    exit 1
  fi
  key="$(grep -oiE '^arc-[0-9]+' <<<"$branch")" || true
  key="${key^^}"
  printf 'Close %s: remove %s%s? [y/N] ' "$branch" "$path" "${key:+ and mark $key Done}"
  read -r answer </dev/tty
  [[ $answer =~ ^[Yy] ]] || exit 0

  keepsakes="$(ignored_keepsakes "$path")"
  handoff="$(git -C "$path" rev-parse --path-format=absolute --git-path HANDOFF.md)"
  [ -e "$handoff" ] || handoff=""
  if [ -n "$keepsakes$handoff" ]; then
    echo "Removing the checkout also deletes these, which Git does not track:"
    [ -z "$keepsakes" ] || indent <<<"$keepsakes"
    [ -z "$handoff" ] || echo "  $handoff (task handoff)"
    printf 'Delete them? [y/N] '
    read -r answer </dev/tty
    [[ $answer =~ ^[Yy] ]] || exit 0
  fi

  unpushed="$(git -C "$repo" log --oneline "$branch" --not --remotes)"
  if [ -n "$unpushed" ] && [ -n "$key" ]; then
    echo "$branch has commits that are on no remote:"
    indent <<<"$unpushed"
    printf 'Still mark %s Done? [y/N] ' "$key"
    read -r answer </dev/tty
    if ! [[ $answer =~ ^[Yy] ]]; then
      echo "Leaving $key open; finish it later with: herdr-arc finish $(printf '%q %q' "$repo" "$key")"
      key=""
    fi
  fi

  git -C "$repo" worktree remove "$path"
  git -C "$repo" branch -d "$branch" 2>/dev/null ||
    echo "Kept branch $branch (not merged into HEAD)"
  if [ -n "$key" ]; then
    if ! finish_ticket "$key"; then
      printf 'Local checkout removed. Retry Jira only: herdr-arc finish %q %q\n' "$repo" "$key" >&2
      [ -z "$space" ] || printf 'After recovery, close the remaining Space: herdr workspace close %q\n' "$space" >&2
      return 1
    fi
  fi
  # Last: launched from inside that Space, this pane and its terminal close
  # with it, which can end the herdr call itself non-zero. The work is done by
  # then, so neither that status nor the failure hold applies.
  if [ -n "$space" ]; then
    trap - EXIT
    herdr workspace close "$space" || true
  fi
}

[ $# -ge 2 ] || usage
command=$1
repo=$2
shift 2
# The detached `new` already writes straight to the journal (systemd-cat).
if [ -n "$detached" ]; then
  trap notify_on_failure EXIT
else
  case $command in
  list | tickets | current) log_to_journal picker "$@" ;;
  *)
    log_to_journal "" "$@"
    trap hold_on_failure EXIT
    ;;
  esac
fi
case $command in
new) cmd_new "$@" ;;
tickets) cmd_tickets ;;
key) cmd_key "$@" ;;
list) cmd_list "$@" ;;
current) cmd_current ;;
open) cmd_open "$@" ;;
close) cmd_close "$@" ;;
finish) cmd_finish "$@" ;;
*) usage ;;
esac
